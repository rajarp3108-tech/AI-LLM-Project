PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-secret

# LLM provider. Required for full, in-depth answers and comprehensive
# document/form analysis; without it the app falls back to returning raw
# extracted text and basic keyword search. No upload is required when this
# is configured; users can ask about any topic.
#
# Both native Anthropic (Claude) and OpenAI-compatible chat-completions
# endpoints are supported automatically — detected from the URL / model name.
#
# Examples:
#   Anthropic (native): LLM_API_URL=https://api.anthropic.com/v1/messages
#                        LLM_MODEL=claude-sonnet-4-5-20250929 (or any claude-* model)
#                        LLM_API_KEY=sk-ant-...
#   OpenAI:              LLM_API_URL=https://api.openai.com/v1/chat/completions
#                        LLM_MODEL=gpt-4o
#   Local/OSS:           any OpenAI-compatible endpoint (Ollama, vLLM, etc.)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
